@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Bienvenido a CosturaShop</h1>
    <p class="lead">Ideal para pedir prendas de ropa a tu medida</p>
</div>

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">1. Explora el catálogo</h5>
                <p class="card-text">En esta tienda encontrarás chaquetas, pantalones y combos</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">2. Agrega al carrito</h5>
                <p class="card-text">Te invitamos a que elijas una buena cantidad de productos</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">3. Confirma tu pedido</h5>
                <p class="card-text">Una vez escogido el pedido, nuestro costurero de confianza se contactará contigo, para confirmar el pedido y pulir los últimos detalles</p>
            </div>
        </div>
    </div>
</div>
