@model CosturaShop.Models.Producto
@using CosturaShop.Models

<form asp-action = "Delete" method = "post">

  <input type="hidden" asp-for="Id" />

  <table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>Precio</th>
            <th>Material</th>
            <th>Talla</th>
            <th>Color</th>
            <th>Tipo</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Nombre</td>
            <td>@Model.Descripcion</td>
            <td>@Model.Precio</td>
            <td>@Model.Material</td>
            <td>@Model.Talla</td>
            <td>@Model.Color</td>
            <td>@Model.Tipo</td>
        </tr>
    </tbody>
  </table>

  <button type = "submit" class="btn btn-danger btn-sm">Eliminar</button>

</form>