@model CosturaShop.Models.Producto
@using CosturaShop.Models

<form asp-action = "Edit" method = "post">

  <input type = "hidden" asp-for = "Id" />
  <div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
  </div>
  <div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <input asp-for="Descripcion" class="form-control" />
  </div>
  <div class="mb-3">
    <label asp-for="Precio" class="form-label"></label>
    <input asp-for="Precio" class="form-control" />
  </div>
  <div class="mb-3">
    <label asp-for="Material" class="form-label"></label>
    <input asp-for="Material" class="form-control" />
  </div>
  <div class="mb-3">
    <label asp-for="Talla" class="form-label"></label>
    <input asp-for="Talla" class="form-control" />
  </div>
  <div class="mb-3">
    <label asp-for="Color" class="form-label"></label>
    <input asp-for="Color" class="form-control" />
  </div>

  <div class="mb-3">
    <label asp-for="Tipo" class="form-label"></label>
    <select asp-for = "Tipo" class="form-control" asp-items = "Html.GetEnumSelectList<TipoProducto>()" ></select>
  </div>

  <button type = "submit" class="btn btn-primary">Guardar</button>

</form>