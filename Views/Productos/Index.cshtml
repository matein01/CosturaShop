@model List<CosturaShop.Models.Producto>

  <h1>Catálogo de Productos</h1>

@foreach (var producto in Model){

  <p>@producto.Nombre</p>
  <p>@producto.Precio</p>
  <p>@producto.Tipo</p>
  <a asp-action = "Edit" asp-route-idProductoEditar = "@producto.Id">Editar</a>
  <a asp-action = "Delete" asp-route-idProductoEliminar = "@producto.Id">Eliminar</a>
}