@model List<CosturaShop.Models.Producto>

<h1>Catálogo de Productos</h1>

<a asp-action = "Create" class="btn btn-success btn-sm">Agregar</a>

<table class="table table-striped">
  <thead>
      <tr>
          <th>Nombre</th>
          <th>Precio</th>
          <th>Tipo</th>
          <th>Editar</th>
          <th>Eliminar</th>
      </tr>
  </thead>
  <tbody>
    @foreach (var producto in Model)
    {
      <tr>
          <td>@producto.Nombre</td>
          <td>@producto.Precio</td>
          <td>@producto.Tipo</td>
          <td><a asp-action="Edit" asp-route-idProductoEditar="@producto.Id" class="btn btn-warning btn-sm">Editar</a></td>
          <td><a asp-action="Delete" asp-route-idProductoEliminar="@producto.Id" class="btn btn-danger btn-sm">Eliminar</a></td>
      </tr>
    }
  </tbody>
</table>

<h1>Catálogo de Combos</h1>

<a asp-controller="Combos" asp-action = "Create" class="btn btn-success btn-sm">Agregar</a>

<table class="table table-striped">
  <thead>
      <tr>
          <th>Nombre</th>
          <th>Precio</th>
          <th>Chaqueta</th>
          <th>Pantalon</th>
          <th>Editar</th>
          <th>Eliminar</th>
      </tr>
  </thead>
  <tbody>
    @foreach (var combo in ViewBag.Combos)
    {
      <tr>
          <td>@combo.Nombre</td>
          <td>@combo.Precio</td>
          <td>@combo.Chaqueta?.Nombre</td>
          <td>@combo.Pantalon?.Nombre</td>
          <td><a asp-controller="Combos" asp-action="Edit" asp-route-idComboEditar="@combo.Id" class="btn btn-warning btn-sm">Editar</a></td>
          <td><a asp-controller="Combos" asp-action="Delete" asp-route-idComboEliminar="@combo.Id" class="btn btn-danger btn-sm">Eliminar</a></td>
      </tr>
    }
  </tbody>
</table>
