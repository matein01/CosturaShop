@model List<CosturaShop.Models.Producto>

<h1>Catálogo de Productos</h1>

<table class="table table-striped">
  <thead>
      <tr>
          <th>Nombre</th>
          <th>Precio</th>
          <th>Tipo</th>
          <th>Agregar</th>
      </tr>
  </thead>
  <tbody>
    @foreach (var producto in Model)
    {
      <tr>
          <td>@producto.Nombre</td>
          <td>@producto.Precio</td>
          <td>@producto.Tipo</td>
          <td><a asp-action = "AgregarAlCarrito" asp-route-idProducto = "@producto.Id">Agregar carrito</a></td>
      </tr>
    }
  </tbody>
</table>

<h1>Catálogo de Combos</h1>

<table class="table table-striped">
  <thead>
      <tr>
          <th>Nombre</th>
          <th>Precio</th>
          <th>Chaqueta</th>
          <th>Pantalon</th>
          <th>Agregar</th>
      </tr>
  </thead>
  <tbody>
    @foreach (var combo in ViewBag.Combos)
    {
      <tr>
          <td>@combo.Nombre</td>
          <td>@combo.Precio</td>
          <td>@combo.Chaqueta?.Nombre</td>
          <td>@combo.Pantalon?.Nombre</td>
          <td><a asp-action = "AgregarAlCarrito" asp-route-idCombo = "@combo.Id">Agregar carrito</a></td>
      </tr>
    }
  </tbody>
</table>