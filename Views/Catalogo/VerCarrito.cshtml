@using CosturaShop.Models
@model List<CosturaShop.Models.ItemCarritoDetallado>

<h1>Carrito de Productos seleccionados</h1>

<table class="table table-striped">
  <thead>
      <tr>
          <th>Nombre</th>
          <th>Precio</th>
          <th>Tipo</th>
          <th>Cantidad</th>
      </tr>
  </thead>
  <tbody>
    @foreach (ItemCarritoDetallado item  in Model)
    {
      <tr>
          <td>
            @if (item.Producto != null)
            {
              @item.Producto.Nombre
            }
            else
            {
              @item.Combo?.Nombre
            }
          </td>

          <td>
            @if (item.Producto != null)
            {
              @item.Producto.Precio
            }
            else
            {
              @item.Combo?.Precio
            }
          </td>

          <td>
            @if (item.Producto != null)
            {
              @item.Producto.Tipo
            }
            else
            {
              <p>Combo</p>
            }
          </td>

          <td>@item.Cantidad</td>
      </tr>
    }
  </tbody>
</table>

<a asp-action = "Checkout">Confirmar pedido</a>