@model CosturaShop.Models.DatosCheckout

<h1>Finalizar pedido</h1>

<table class="table table-striped">
  <thead>
      <tr>
          <th>Nombre</th>
          <th>Precio</th>
          <th>Cantidad</th>
      </tr>
  </thead>
  <tbody>
    @foreach (var item in ViewBag.Carrito)
    {
      <tr>
          <td>
            @if (item.Producto != null)
            {
              @item.Producto.Nombre
            }
            else
            {
              @item.Combo?.Nombre
            }
          </td>

          <td>
            @if (item.Producto != null)
            {
              @item.Producto.Precio
            }
            else
            {
              @item.Combo?.Precio
            }
          </td>

          <td>@item.Cantidad</td>
      </tr>
    }
  </tbody>
</table>

<form asp-action = "Checkout" method = "post">

  <div class="mb-3">
    <label asp-for="NombreCliente" class="form-label"></label>
    <input asp-for="NombreCliente" class="form-control" />
  </div>

  <div class="mb-3">
    <label asp-for="Telefono" class="form-label"></label>
    <input asp-for="Telefono" class="form-control" />
  </div>

  <div class="mb-3">
    <label asp-for="Correo" class="form-label"></label>
    <input asp-for="Correo" class="form-control" />
  </div>

  <button type = "submit" class="btn btn-success btn-sm">Enviar</button>

</form>