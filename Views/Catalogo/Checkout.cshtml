@model CosturaShop.Models.DatosCheckout

<h1>Finalizar pedido</h1>

@foreach (var item in ViewBag.Carrito)
{
  <p>@item.Producto.Nombre</p>
  <p>@item.Producto.Precio</p>
  <p>@item.Cantidad</p>
}

<form asp-action = "Checkout" method = "post">

  <label asp-for = "NombreCliente"></label>
  <input asp-for = "NombreCliente" />
  <label asp-for = "Telefono"></label>
  <input asp-for = "Telefono" />
  <label asp-for = "Correo"></label>
  <input asp-for = "Correo" />

  <button type = "submit" >Enviar</button>

</form>