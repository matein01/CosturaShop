@model CosturaShop.Models.Combo
@using CosturaShop.Models

<form asp-action = "Create" method = "post">

  <div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
  </div>

  <div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <input asp-for="Descripcion" class="form-control" />
  </div>

  <div class="mb-3">
    <label asp-for="Precio" class="form-label"></label>
    <input asp-for="Precio" class="form-control" />
  </div>

  <div class="mb-3">
    <label asp-for="Chaqueta" class="form-label"></label>
    <select asp-for = "ChaquetaId" class="form-control" asp-items = "ViewBag.Chaquetas" ></select>
  </div>

  <div class="mb-3">
    <label asp-for="Pantalon" class="form-label"></label>
    <select asp-for = "PantalonId" class="form-control" asp-items = "ViewBag.Pantalones" ></select>
  </div>

  <button type = "submit" class="btn btn-primary">Guardar</button>

</form>